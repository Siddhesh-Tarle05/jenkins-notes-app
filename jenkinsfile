pipeline {

    agent {
        label 'docker-agent'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            steps {
                sh 'docker compose -f docker-compose.build.yaml build'
            }
        }

        stage('Push Images') {
            steps {
                sh 'docker compose -f docker-compose.build.yaml push'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker compose -f docker-compose.deploy.yaml pull
                    docker compose -f docker-compose.deploy.yaml up -d
                '''
            }
        }
    }
}