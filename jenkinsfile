pipeline{
    agent{
        label 'docker-agent'
    }
    stages{
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Build Images'){
            steps{
                sh 'docker compose build'
            }
        }
        stage('Push Images'){
            steps{
                sh 'docker compose push'
            }
        }
        stage('Pull Images'){
            steps{
                sh 'docker compose pull'
            }
        }
        stage('Deploy'){
            steps{
                sh 'docker compose up -d'
            }
        }
    }
}